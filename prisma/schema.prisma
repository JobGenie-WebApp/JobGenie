  type    String  @db.Text // notification type: invitation_received, interview_scheduled, etc.
  title   String  @db.Text
  body    String? @db.Text
  data    Json?   // Additional context: {invitation_id, round_id, offer_id, etc.}
  is_read Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Indexes matching the SQL migration
  @@index([user_id, is_read, created_at(sort: Desc)]) // For unread notifications query
  @@index([user_id, created_at(sort: Desc)])          // For notification history
  /// Supabase Realtime enabled: REPLICA IDENTITY FULL (migration: enable_realtime_for_notification_tables)
  @@map("notifications")
}

