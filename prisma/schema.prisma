  bank_code      String?  @db.VarChar(50)
  swift_code     String?  @db.VarChar(50)
  is_active      Boolean  @default(true)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  @@index([is_active])
  @@map("payment_bank_details")
}

model PaymentRequest {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id              String               @db.Uuid
  employer_id             String?              @db.Uuid
  created_by_mis_user_id  String               @db.Uuid
  payment_type_id         String               @db.Uuid
  reference_job_id        String?              @db.Uuid
  reference_invitation_id String?              @db.Uuid
  amount                  Decimal              @db.Decimal(12, 2)
  currency                String               @default("LKR") @db.VarChar(10)
  description             String               @db.Text
  due_date                DateTime?            @db.Date
  status                  PaymentRequestStatus @default(pending_payment)
  bank_transfer_reference String?              @db.VarChar(200)
  created_at              DateTime             @default(now()) @db.Timestamptz(6)
  updated_at              DateTime             @updatedAt @db.Timestamptz(6)

  company              Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employer             Employer?      @relation(fields: [employer_id], references: [id], onDelete: SetNull)
  created_by_mis       MisUser        @relation("PaymentRequestCreator", fields: [created_by_mis_user_id], references: [user_id])
  payment_type         PaymentType    @relation(fields: [payment_type_id], references: [id])
  reference_job        Job?           @relation(fields: [reference_job_id], references: [id], onDelete: SetNull)
  reference_invitation JobInvitation? @relation(fields: [reference_invitation_id], references: [id], onDelete: SetNull)
  payment_proofs       PaymentProof[]

  @@index([company_id])
  @@index([employer_id])
  @@index([status])
  @@index([payment_type_id])
  @@index([created_at])
  @@index([due_date])
  /// Supabase Realtime enabled: REPLICA IDENTITY FULL (migration: enable_realtime_for_notification_tables)
  @@map("payment_requests")
}

model PaymentProof {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_request_id      String             @db.Uuid
  uploaded_by_employer_id String             @db.Uuid
  file_url                String             @db.VarChar(500)
  file_path               String             @db.VarChar(500)
  file_name               String             @db.VarChar(255)
  file_type               String             @db.VarChar(100)
  uploaded_at             DateTime           @default(now()) @db.Timestamptz(6)
  reviewed_by_mis_user_id String?            @db.Uuid
  reviewed_at             DateTime?          @db.Timestamptz(6)
  review_notes            String?            @db.Text
  status                  PaymentProofStatus @default(pending_review)

  payment_request PaymentRequest @relation(fields: [payment_request_id], references: [id], onDelete: Cascade)
  uploaded_by     Employer       @relation(fields: [uploaded_by_employer_id], references: [id])
  reviewed_by     MisUser?       @relation("PaymentProofReviewer", fields: [reviewed_by_mis_user_id], references: [user_id])

  @@index([payment_request_id])
  @@index([status])
  @@map("payment_proofs")
}

enum PaymentRequestStatus {
  pending_payment
  under_review
  verified
  rejected
  cancelled
}

enum PaymentProofStatus {
  pending_review
  approved
  rejected
}
