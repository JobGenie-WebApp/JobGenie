# =============================================================================
# JobGenie — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development (Next.js loads it
# automatically). Never commit real secrets.
#
# Supabase values: Dashboard → Project Settings → API (URL, anon / publishable
# keys, service_role). Database URI: Project Settings → Database.
#
# ── New database setup (run once after creating a Supabase project) ──────────
#
#   1. Fill in all variables below
#   2. Run:  npm run db:setup
#            (deploys Prisma schema migrations, then applies all RLS
#             policies, grants, helper functions, and storage bucket policies)
#
# ── After a Prisma schema change (new table / column) ────────────────────────
#
#   npm run db:setup        (migrate + re-apply policies)
#   — or —
#   npm run db:policies     (policies only, tables already exist)
#
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public (safe to expose in the browser; still prefer not to log)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Legacy JWT **anon** key (Dashboard may label it "anon" / "public").
# Required by `src/middleware.ts` for `@supabase/ssr` cookie sessions on
# protected and auth routes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# **Publishable** key (`sb_publishable_...`) or, if you do not use the new key
# yet, the same legacy anon JWT as above.
# Used by `src/lib/supabase/client.ts`, `server.ts`, and `proxy.ts`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Supabase — server-only (never prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# **service_role** secret. Used by `src/lib/supabase/admin.ts` and
# `scripts/cleanup-logs.ts`. Bypasses RLS — keep private.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Postgres — Prisma + direct SQL
# -----------------------------------------------------------------------------
# Used by `prisma.config.ts` (Prisma) and `src/lib/db/server-postgres.ts`.
# Prefer the Supabase connection pooler URI for serverless / many short-lived
# connections; use the direct host only if your deployment docs require it.
# Example shape: postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Payload CMS — content management (isolated from Prisma operational data)
# -----------------------------------------------------------------------------
# Use a separate Postgres database/project for Payload. Do NOT reuse DATABASE_URL
# unless you have intentionally isolated Payload in a separate database.
PAYLOAD_DATABASE_URL=

# Required by Payload auth/cookies. Use a long random value in every environment.
PAYLOAD_SECRET=

# Absolute app URL used by Payload for cookies/CORS/CSRF.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Keep false for normal migration-managed environments. You may set true only
# against a throwaway local CMS database while prototyping schema changes.
PAYLOAD_DB_PUSH=false

# Optional: Supabase Storage S3-compatible media backend for Payload uploads.
# These are server-only secrets. Supabase S3 keys bypass RLS, so never expose
# them with NEXT_PUBLIC_.
PAYLOAD_S3_BUCKET=
PAYLOAD_S3_ENDPOINT=
PAYLOAD_S3_REGION=auto
PAYLOAD_S3_ACCESS_KEY_ID=
PAYLOAD_S3_SECRET_ACCESS_KEY=
PAYLOAD_S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# App URL (emails and absolute links)
# -----------------------------------------------------------------------------
# If unset, `src/lib/email.ts` falls back to http://localhost:3000
# Production example: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Outbound email (SMTP)
# -----------------------------------------------------------------------------
# Used by `src/lib/email.ts`, `employer-emails.ts`, and `interview-emails.ts`.
# If SMTP_USER / SMTP_PASS are missing, many flows log email content to the
# console instead (useful for local dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# MIS (management) settings
# -----------------------------------------------------------------------------
# Invitation link validity in days (default 7).
MIS_INVITATION_EXPIRY_DAYS=7
# Maximum MIS admins allowed (default 3). See `src/app/actions/auth.ts`.
MIS_MAX_ADMINS=3

# First super-admin auto-seeded on server startup (src/instrumentation.ts →
# src/lib/bootstrap/seed-super-admin.ts). If email + password are set and no
# super admin exists yet, one is created with is_super_admin=true (all permissions).
# Leave email/password blank to disable the auto-seed.
MIS_SUPERADMIN_EMAIL=
MIS_SUPERADMIN_PASSWORD=
MIS_SUPERADMIN_FIRST_NAME=Super
MIS_SUPERADMIN_LAST_NAME=Admin

# -----------------------------------------------------------------------------
# Cron — interview reminder emails (optional)
# -----------------------------------------------------------------------------
# Shared secret for cron endpoints (sent as `Authorization: Bearer <CRON_SECRET>`
# header only — Vercel Cron adds this automatically when the var is set).
CRON_SECRET=
# How far ahead the reminder job scans for upcoming interviews (1–90 days, default 30).
INTERVIEW_REMINDER_LOOKAHEAD_DAYS=30

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiting / DDoS & brute-force protection
# -----------------------------------------------------------------------------
# Used by `src/lib/rate-limit.ts` (enforced in `src/middleware.ts`).
# Create a free database at https://console.upstash.com → Redis, then copy the
# REST URL + token. If these are unset, rate limiting is DISABLED (fail-open) —
# set them in production. Add the same values to Vercel env (Dev + Prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Google Gemini (optional features)
# -----------------------------------------------------------------------------
# Required for CV parsing (`src/app/actions/extract-cv.ts`) and BR certificate
# checks (`src/app/actions/verify-br-certificate.ts`).
GEMINI_API_KEY=
